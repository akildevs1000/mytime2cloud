{
  "name": "mytime2cloud-desktop-app",
  "version": "09.06.2026",
  "description": "mytime2cloud-desktop-app",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "desktop.mytime2cloud",
    "files": [
      "assets/**/*",
      "helpers.js",
      "index.html",
      "main.js"
    ],
    "extraResources": [
      {
        "from": "kill-processes.bat",
        "to": "kill-processes.bat"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "conf",
        "to": "conf"
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "logs",
        "to": "logs"
      },
      {
        "from": "temp",
        "to": "temp"
      },
      {
        "from": "nginx.exe",
        "to": "nginx.exe"
      },
      {
        "from": "vs_redist.exe",
        "to": "vs_redist.exe"
      },
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "dotnet_sdk",
        "to": "dotnet_sdk",
        "filter": [
          "**/*",
          "!.git/**",
          "!**/*.pdb",
          "!dotnet/sdk/**",
          "!dotnet/packs/**",
          "!dotnet/templates/**",
          "!dotnet/shared/Microsoft.WindowsDesktop.App/**"
        ]
      },
      {
        "from": "java_sdk",
        "to": "java_sdk",
        "filter": ["**/*", "!jmods/**"]
      }
    ],
    "productName": "MyTime2Desktop",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "frontend/dist/favicon-256x256.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "license.txt",
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "fs-extra": "^11.3.2",
    "ws": "^8.18.3"
  }
}
